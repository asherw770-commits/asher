rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app with no login. The one doc below is world-readable
    // and world-writable - security is by URL obscurity only. Anyone who
    // knows the Firebase project id (visible in the client HTML) can read
    // and modify it. Do not share the app URL.
    match /shared/main {
      allow read, write: if true;
    }
  }
}
