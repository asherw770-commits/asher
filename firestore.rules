rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own data, under
    // users/{their-own-uid}/appdata/*. Nobody else - authenticated or
    // not - can touch it. This is the actual security boundary; the
    // Firebase apiKey in the client code is not a secret by itself.
    match /users/{userId}/appdata/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
